{
	"schemaVersion": 1,
	"id": "lightbox",
	"version": "${version}",
	"name": "Lightbox",
	"description": "A Minecraft mod that introduces a screenshot gallery, with capabilities for renaming, deleting, favouriting, and editing.",
	"authors": [
		"Hooverdawg"
	],
	"contact": {
		"homepage": "https://hooverdawg.nekoweb.org/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/lightbox/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.hooverdawg.lightbox.Lightbox"
		],
		"client": [
			"net.hooverdawg.lightbox.LightboxClient"
		],
		"fabric-datagen": [
			"net.hooverdawg.lightbox.LightboxDataGenerator"
		]
	},
	"mixins": [
		"lightbox.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}